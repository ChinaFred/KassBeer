rules_version = '2';

// Règles Firestore de Kass'Beer, version 1. Seul contrôle d'accès de l'application
// (ADR-001) : chaque changement arrive avec ses tests dans rules-tests/ (P4).
//
// Modèle décrit dans documentation/exigences-techniques.md, « Modèle de données ».
// Tout chemin non nommé ici est refusé : Firestore refuse par défaut.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Identité

    // Compte Google à l'adresse vérifiée (P11). Un compte e-mail / mot de passe,
    // ou une adresse non vérifiée, n'ouvre rien, même invité.
    function isGoogleVerified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Identifiant de members/ du compte connecté : son e-mail en minuscules.
    function emailKey() {
      return request.auth.token.email.lower();
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(emailKey());
    }

    function isMember() {
      return isGoogleVerified() && exists(memberPath());
    }

    function isAdmin() {
      return isMember() && get(memberPath()).data.role == 'admin';
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- Outils

    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }

    // Pourcentage de 0 à 100 : un rendement à 150 % rendrait « Calcul impossible »
    // toutes les recettes qui utilisent l'équipement.
    function optPercent(d, k) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= 0 && d[k] <= 100);
    }

    // Nombre fini et borné : Infinity et NaN rendraient le document illisible par
    // l'application. Une comparaison avec NaN est fausse, donc NaN est refusé aussi.
    function optNumber(d, k) {
      return !(k in d) || d[k] == null
        || (d[k] is number && d[k] > -1000000000 && d[k] < 1000000000);
    }

    function optList(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= max);
    }

    // Liste de BeerJSON (ingrédients, paliers) : absente, ou liste bornée. null est
    // refusé : BeerJSON n'a pas de null. Moins coûteux qu'optList, qui compare la
    // liste à null (budget, voir brews/).
    function optArray(d, k, max) {
      return d.get(k, []) is list && d.get(k, []).size() <= max;
    }

    function optTimestamp(d, k) {
      return !(k in d) || d[k] == null || d[k] is timestamp;
    }

    function optBool(d, k) {
      return !(k in d) || d[k] == null || d[k] is bool;
    }

    // Nombre de bouteilles : entier de 1 à 9 999, comme le formulaire d'embouteillage.
    function optBottlesCount(d) {
      return !('bottles_count' in d) || d.bottles_count == null
        || (d.bottles_count is int && d.bottles_count >= 1 && d.bottles_count <= 9999);
    }

    function optPackagedVolume(d) {
      return !('packaged_volume_l' in d) || d.packaged_volume_l == null
        || (d.packaged_volume_l is number
            && d.packaged_volume_l > 0 && d.packaged_volume_l <= 1000);
    }

    function optPrimingSugar(d) {
      return !('priming_sugar_g' in d) || d.priming_sugar_g == null
        || (d.priming_sugar_g is number
            && d.priming_sugar_g >= 0 && d.priming_sugar_g <= 100000);
    }

    function hasName(d, max) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= max;
    }

    // Création : propriétaire = auteur, dates posées par serverTimestamp().
    function createdByMe(d) {
      return d.owner_uid == request.auth.uid
        && d.created_at == request.time
        && d.updated_at == request.time;
    }

    // Nom de l'auteur affiché au groupe (recettes, équipements). Facultatif ; présent,
    // c'est une chaîne de 1 à 80 caractères égale au nom du jeton de celui qui écrit.
    // Un jeton sans nom n'écrit pas ce champ. Une écriture qui garde un ancien nom,
    // différent du nom actuel du jeton, est refusée : l'application réécrit le nom à
    // chaque enregistrement, ou retire le champ.
    function ownerNameOk(d) {
      return !('owner_name' in d)
        || (d.owner_name is string
            && d.owner_name.size() >= 1
            && d.owner_name.size() <= 80
            && 'name' in request.auth.token
            && d.owner_name == request.auth.token.name);
    }

    // Nom d'auteur gardé dans la copie figée d'un brassin : celui de l'auteur de la
    // recette ou de l'équipement, pas forcément celui qui brasse. Seuls le type et la
    // taille sont contrôlés.
    function snapshotOwnerNameOk(m) {
      return !('owner_name' in m)
        || (m.owner_name is string && m.owner_name.size() >= 1 && m.owner_name.size() <= 80);
    }

    // Modification par le propriétaire : il reste propriétaire, la date de
    // création ne bouge pas, updated_at est posée par serverTimestamp().
    function updatedByOwner() {
      return resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time;
    }

    // ---------------------------------------------------------------- members

    // Identifiant : e-mail en minuscules. Écrit par l'admin seul (P11). Le premier
    // admin se crée dans la console. Pas de modification en v1 : pour changer un
    // rôle, l'admin retire puis réinvite.
    match /members/{memberId} {
      // Un compte Google vérifié lit son propre document, même absent : l'application
      // distingue « compte non invité » d'une panne. Aucun autre document.
      allow get: if isGoogleVerified() && memberId == emailKey();
      allow read: if isAdmin();

      allow create: if isAdmin()
        && memberId == memberId.lower()
        && request.resource.data.keys().hasOnly(
             ['email', 'role', 'display_name', 'invited_at', 'invited_by'])
        && request.resource.data.keys().hasAll(
             ['email', 'role', 'invited_at', 'invited_by'])
        && request.resource.data.email == memberId
        && memberId.matches('^[^@\\s]+@[^@\\s]+$')
        && memberId.size() <= 254
        && request.resource.data.role in ['admin', 'brewer']
        && optString(request.resource.data, 'display_name', 80)
        && request.resource.data.invited_at == request.time
        && request.resource.data.invited_by == request.auth.uid;

      allow update: if false;

      // Un admin ne retire ni son propre accès (il resterait sans administrateur), ni
      // celui d'un autre admin : un administrateur se retire depuis la console Firebase.
      allow delete: if isAdmin()
        && memberId != emailKey()
        && resource.data.role != 'admin';
    }

    // ---------------------------------------------------------------- recipes

    // Recette en BeerJSON partiel (ADR-005) : une enveloppe propre à Kass'Beer et le
    // sous-arbre `recipe`, qui suit RecipeType du schéma BeerJSON au commit figé
    // 4370892d44. Aucun prix ni stock (P5) : les prix vivent sous users/{uid}/prices.
    // Les éléments des listes (ingrédients, paliers, étapes de la chronologie) ne
    // peuvent pas être inspectés par les règles ; le dépôt de données ne les écrit
    // qu'à partir de ses types, sans prix.
    function recipeFields() {
      return ['format_version', 'owner_uid', 'owner_name', 'equipment_id', 'imported_from',
              'brew_steps', 'recipe', 'created_at', 'updated_at'];
    }

    // Couple {value, unit} : absent, ou complet dans l'unité canonique de la grandeur.
    // Jamais une unité sans valeur. Valeur finie et bornée, comme optNumber : une
    // comparaison avec un texte est une erreur, et une erreur refuse l'écriture.
    function optMeasure(m, k, unit) {
      return !(k in m)
        || (m[k].keys().hasOnly(['value', 'unit']) && m[k].unit == unit
            && m[k].value > -1000000000 && m[k].value < 1000000000);
    }

    // Durée BeerJSON (TimeType) : minutes entières, positives ou nulles.
    function optMinutes(m, k) {
      return !(k in m)
        || (m[k].keys().hasOnly(['value', 'unit']) && m[k].unit == 'min'
            && m[k].value is int && m[k].value >= 0 && m[k].value < 1000000000);
    }

    // `RecipeType.type` : toutes les valeurs du schéma figé, comme la lecture de
    // l'application (typesRecette, beerjson.dart).
    function recipeTypes() {
      return ['cider', 'kombucha', 'soda', 'other', 'mead', 'wine', 'extract', 'partial mash',
              'all grain'];
    }

    // Sous-arbre `recipe`. Les champs obligatoires de BeerJSON absents permis (type,
    // author, batch_size, boil, mash…) sont la liste fermée d'ADR-005. `author`,
    // conservé d'un import, est un texte de 1 à 120 caractères. `efficiency` est
    // refusé : le rendement d'un fichier importé n'est pas gardé, l'export l'écrit
    // depuis l'équipement (ADR-005, amendement de L2). `water_additions` est
    // refusé : l'eau n'entre pas en version 1. `name` et `ingredients` sont
    // obligatoires : les lire sans eux est une erreur, et une erreur refuse l'écriture.
    //
    // Les maps `style`, `boil`, `mash` et `ingredients` sont fermées : keys() sur une
    // valeur qui n'est pas une map est une erreur, qui refuse l'écriture (une liste ou
    // un texte à la place de `boil` est refusé sans test `is map`, qui coûte des
    // expressions). `type` absent se lit comme une valeur du schéma ; présent, il en est
    // une. `mash.name` est un libellé que l'application écrit (« Empâtage ») et ne
    // relit pas : les règles le bornent à 120 caractères. Les éléments des listes ne
    // sont pas inspectés (risque accepté, exigences-techniques.md, « Règles
    // d'accès ») : la lecture typée de l'application ignore un champ inconnu.
    // Budget : voir brews/.
    function isBeerJsonRecipe(r) {
      return r.keys().hasOnly(['name', 'type', 'author', 'notes', 'style', 'batch_size',
                               'boil', 'mash', 'ingredients'])
        && hasName(r, 120)
        && r.get('type', 'all grain') in recipeTypes()
        && (!('author' in r)
            || (r.author is string && r.author.size() >= 1 && r.author.size() <= 120))
        && optString(r, 'notes', 10000)
        && (!('style' in r) || (r.style.keys().hasOnly(['name']) && hasName(r.style, 120)))
        && optMeasure(r, 'batch_size', 'l')
        && (!('boil' in r)
            || (r.boil.keys().hasOnly(['boil_time']) && optMinutes(r.boil, 'boil_time')))
        && (!('mash' in r)
            || (r.mash.keys().hasOnly(['name', 'grain_temperature', 'mash_steps'])
                && (!('name' in r.mash) || hasName(r.mash, 120))
                && optMeasure(r.mash, 'grain_temperature', 'C')
                && optArray(r.mash, 'mash_steps', 20)))
        && r.ingredients.keys().hasOnly(['fermentable_additions', 'hop_additions',
                                         'miscellaneous_additions', 'culture_additions'])
        && optArray(r.ingredients, 'fermentable_additions', 50)
        && optArray(r.ingredients, 'hop_additions', 50)
        && optArray(r.ingredients, 'miscellaneous_additions', 50)
        && optArray(r.ingredients, 'culture_additions', 10);
    }

    // Enveloppe et recette, communes à recipes/ et à la copie figée d'un brassin.
    // format_version : 1 seulement ; un ancien document plat n'a ni ce champ ni
    // `recipe`, et il est refusé. Budget : la création d'un brassin évalue cette
    // fonction dans isBrewCreateShape, à moins de 1 000 expressions au total (voir brews/).
    function isRecipeContent(d) {
      return d.keys().hasOnly(recipeFields())
        && d.format_version is int
        && d.format_version == 1
        && isBeerJsonRecipe(d.recipe)
        && optString(d, 'equipment_id', 128)
        // Chronologie du jour : 60 étapes au plus (key, name, duration_min, temp_c).
        && optList(d, 'brew_steps', 60)
        && optString(d, 'imported_from', 200);
    }

    function isRecipeShape(d) {
      return isRecipeContent(d)
        && d.keys().hasAll(['owner_uid', 'created_at', 'updated_at'])
        && d.owner_uid is string;
    }

    match /recipes/{recipeId} {
      allow read: if isMember();
      allow create: if isMember()
        && isRecipeShape(request.resource.data)
        && ownerNameOk(request.resource.data)
        && createdByMe(request.resource.data);
      allow update: if isMember()
        && isRecipeShape(request.resource.data)
        && ownerNameOk(request.resource.data)
        && updatedByOwner();
      allow delete: if isMember() && resource.data.owner_uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- equipment

    function equipmentFields() {
      return ['owner_uid', 'owner_name', 'name', 'kind', 'mash_efficiency_pct', 'mash_tun_volume_l',
              'kettle_volume_l', 'mash_tun_dead_space_l', 'kettle_dead_space_l',
              'boil_off_l_per_h', 'trub_loss_l', 'fermenter_loss_l',
              'grain_absorption_l_per_kg', 'notes', 'created_at', 'updated_at'];
    }

    function isEquipmentShape(d) {
      return d.keys().hasOnly(equipmentFields())
        && d.keys().hasAll(['owner_uid', 'name', 'kind', 'created_at', 'updated_at'])
        && d.owner_uid is string
        && hasName(d, 120)
        && d.kind in ['multi_vessel', 'all_in_one']
        && optPercent(d, 'mash_efficiency_pct')
        && optNumber(d, 'mash_tun_volume_l')
        && optNumber(d, 'kettle_volume_l')
        && optNumber(d, 'mash_tun_dead_space_l')
        && optNumber(d, 'kettle_dead_space_l')
        && optNumber(d, 'boil_off_l_per_h')
        && optNumber(d, 'trub_loss_l')
        && optNumber(d, 'fermenter_loss_l')
        && optNumber(d, 'grain_absorption_l_per_kg')
        && optString(d, 'notes', 10000);
    }

    // Lisible par le groupe (ADR-001, arbitrage 5).
    match /equipment/{equipmentId} {
      allow read: if isMember();
      allow create: if isMember()
        && isEquipmentShape(request.resource.data)
        && ownerNameOk(request.resource.data)
        && createdByMe(request.resource.data);
      allow update: if isMember()
        && isEquipmentShape(request.resource.data)
        && ownerNameOk(request.resource.data)
        && updatedByOwner();
      allow delete: if isMember() && resource.data.owner_uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- process_templates

    // Modèle de processus (ADR-009, P38) : de 1 à 5 journées nommées, chacune avec son
    // écart en jours et ses étapes. Lisible par le groupe, comme une recette ; écrit
    // par son auteur. Les journées et leurs étapes ne sont pas inspectées : l'application
    // vérifie leurs contraintes avant d'écrire, et les écrit à partir de ses types, sans
    // prix, stock ni coût (P5).
    function processTemplateFields() {
      return ['format_version', 'owner_uid', 'owner_name', 'name', 'notes', 'sessions',
              'created_at', 'updated_at'];
    }

    function isProcessTemplateShape(d) {
      return d.keys().hasOnly(processTemplateFields())
        && d.keys().hasAll(['format_version', 'owner_uid', 'name', 'sessions', 'created_at',
                            'updated_at'])
        && d.format_version is int
        && d.format_version == 1
        && d.owner_uid is string
        && hasName(d, 120)
        && optString(d, 'notes', 10000)
        && d.sessions is list
        && d.sessions.size() >= 1
        && d.sessions.size() <= 5;
    }

    match /process_templates/{templateId} {
      allow read: if isMember();
      allow create: if isMember()
        && isProcessTemplateShape(request.resource.data)
        && ownerNameOk(request.resource.data)
        && createdByMe(request.resource.data);
      allow update: if isMember()
        && isProcessTemplateShape(request.resource.data)
        && ownerNameOk(request.resource.data)
        && updatedByOwner();
      allow delete: if isMember() && resource.data.owner_uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- brews

    function brewFields() {
      return ['owner_uid', 'owner_name', 'recipe_id', 'name', 'status', 'planned_for', 'brewed_at',
              'recipe_snapshot', 'equipment_snapshot', 'adjustments', 'bottles_count',
              'bottled_at', 'packaged_volume_l', 'priming_sugar_g', 'priming_sugar_name',
              'og_event_id', 'fg_event_id', 'fermenter_volume_event_id', 'sugars_in_wort',
              'notes', 'imported_from', 'process', 'created_at', 'updated_at'];
    }

    // Déroulé figé d'un brassin (ADR-009) : modèle résolu avec la recette figée, écrit
    // par une modification juste après la création, jamais à la création (budget de
    // isBrewCreateShape). Nul, ou map aux clés en liste blanche. Les journées ne sont
    // pas inspectées : l'application les écrit à partir de ses types, clés d'étapes
    // uniques, sans prix ni coût (P5, P37).
    function isProcess(p) {
      return p == null
        || (p.keys().hasOnly(['format_version', 'template_id', 'template_name', 'sessions'])
            && p.format_version is int
            && p.format_version == 1
            && optString(p, 'template_id', 128)
            && optString(p, 'template_name', 120)
            && p.sessions is list
            && p.sessions.size() >= 1
            && p.sessions.size() <= 5);
    }

    // Ajustements du jour d'un brassin : nombres seuls, clés en liste blanche, unités du
    // système international. Aucun prix ni coût (P5) : une clé absente de la liste est
    // refusée.
    function adjustmentFields() {
      return ['batch_volume_l', 'mash_water_l', 'sparge_water_l', 'pre_boil_volume_l',
              'post_boil_volume_l', 'fermenter_volume_l', 'boil_off_l_per_h', 'mash_temp_c',
              'mash_time_min', 'boil_time_min', 'mash_efficiency_pct'];
    }

    function isAdjustments(a) {
      return a is map
        && a.keys().hasOnly(adjustmentFields())
        && optNumber(a, 'batch_volume_l')
        && optNumber(a, 'mash_water_l')
        && optNumber(a, 'sparge_water_l')
        && optNumber(a, 'pre_boil_volume_l')
        && optNumber(a, 'post_boil_volume_l')
        && optNumber(a, 'fermenter_volume_l')
        && optNumber(a, 'boil_off_l_per_h')
        && optNumber(a, 'mash_temp_c')
        && optNumber(a, 'mash_time_min')
        && optNumber(a, 'boil_time_min')
        && optPercent(a, 'mash_efficiency_pct');
    }

    // Modification d'un brassin : seuls les champs changés sont contrôlés. Un champ
    // inchangé l'a été à son écriture (création, ou modification précédente), et la
    // copie figée ne change plus. Un champ obligatoire retiré (name, status) rend la
    // lecture en erreur, et une erreur refuse l'écriture ; owner_uid et created_at sont
    // vérifiés par updatedByOwner. Budget : contrôler tous les champs à chaque
    // modification dépasse 1 000 expressions sur un brassin rempli après le brassage
    // avec ses ajustements (mesure de la v0.1.15, voir plus bas).
    function isBrewUpdate(d) {
      let changed = d.diff(resource.data).affectedKeys();
      return d.keys().hasOnly(brewFields())
        && d.keys().hasAll(['owner_uid', 'name', 'status', 'recipe_snapshot',
                            'equipment_snapshot', 'created_at', 'updated_at'])
        // Un brassin fige sa recette : la copie de la recette et de l'équipement, et
        // la recette d'origine, ne changent plus après la création.
        && !changed.hasAny(['recipe_id', 'recipe_snapshot', 'equipment_snapshot'])
        && (!changed.hasAny(['name']) || hasName(d, 120))
        && (!changed.hasAny(['status'])
            || d.status in ['planned', 'brewing', 'fermenting', 'conditioning', 'done',
                            'abandoned'])
        && (!changed.hasAny(['planned_for', 'brewed_at'])
            || (optTimestamp(d, 'planned_for') && optTimestamp(d, 'brewed_at')))
        && (!changed.hasAny(['adjustments'])
            || d.get('adjustments', null) == null || isAdjustments(d.adjustments))
        // Après le brassage : embouteillage et mesures retenues, tous facultatifs.
        // Aucun prix ni coût (P5) ; aucune valeur calculée n'est stockée.
        && (!changed.hasAny(['bottles_count', 'bottled_at', 'packaged_volume_l',
                             'priming_sugar_g', 'priming_sugar_name'])
            || (optBottlesCount(d)
                && optTimestamp(d, 'bottled_at')
                && optPackagedVolume(d)
                && optPrimingSugar(d)
                && optString(d, 'priming_sugar_name', 80)))
        && (!changed.hasAny(['og_event_id', 'fg_event_id', 'fermenter_volume_event_id',
                             'sugars_in_wort'])
            || (optString(d, 'og_event_id', 128)
                && optString(d, 'fg_event_id', 128)
                && optString(d, 'fermenter_volume_event_id', 128)
                && optBool(d, 'sugars_in_wort')))
        && (!changed.hasAny(['notes', 'imported_from'])
            || (optString(d, 'notes', 10000) && optString(d, 'imported_from', 200)))
        // Un brassin fige son déroulé à son départ : process ne change que tant que
        // brewed_at est nul, avant et après l'écriture (ADR-009, P38).
        && (!changed.hasAny(['process'])
            || (resource.data.get('brewed_at', null) == null
                && d.get('brewed_at', null) == null
                && isProcess(d.get('process', null))));
    }

    // Création d'un brassin : les champs que l'application écrit à la création
    // (BrewsRepository.create), et la copie de la recette contrôlée comme recipes/.
    // Les dates de brassage, les ajustements et les champs d'après brassage arrivent
    // par des modifications, contrôlées par isBrewUpdate : les contrôler aussi à la
    // création, avec isRecipeContent, dépasse le budget de 1 000 expressions. Un champ
    // obligatoire absent (status, name, copies) rend la lecture en erreur, et une erreur
    // refuse l'écriture ; owner_uid et les dates sont vérifiés par createdByMe.
    function brewCreateFields() {
      return ['owner_uid', 'owner_name', 'recipe_id', 'name', 'status', 'planned_for',
              'recipe_snapshot', 'equipment_snapshot', 'notes', 'imported_from', 'created_at',
              'updated_at'];
    }

    function isBrewCreateShape(d) {
      return d.keys().hasOnly(brewCreateFields())
        && hasName(d, 120)
        && d.status in ['planned', 'brewing', 'fermenting', 'conditioning', 'done',
                        'abandoned']
        && optString(d, 'recipe_id', 128)
        && optTimestamp(d, 'planned_for')
        && d.equipment_snapshot.keys().hasOnly(equipmentFields())
        && snapshotOwnerNameOk(d.equipment_snapshot)
        && snapshotOwnerNameOk(d.recipe_snapshot)
        && isRecipeContent(d.recipe_snapshot)
        && optString(d, 'notes', 10000)
        && optString(d, 'imported_from', 200);
    }

    // owner_name : nom du brasseur affiché au groupe, comme dans recipes/ (ownerNameOk).
    // Le statut change par des écritures simples ou un WriteBatch du propriétaire. Les
    // règles ne contrôlent pas l'ordre des statuts : un retour en arrière et une file
    // hors ligne doivent passer.
    //
    // Budget : une requête évalue 1 000 expressions au plus, toutes règles comprises
    // (mesuré sur l'émulateur : isRecipeContent en coûte environ 500, et contrôler tous
    // les champs d'un brassin rempli autant). Une erreur n'arrête pas un « && »
    // (error && false vaut false) : chaque règle commence par un contrôle bon marché
    // qui vaut faux, sans erreur, quand elle ne s'applique pas (document absent pour la
    // modification, dates du serveur pour la création). La copie de la recette se vérifie à la création seulement : elle
    // ne change plus ensuite.
    //
    // Mesure de la v0.1.15 (émulateur, recette la plus grande permise, tous les champs
    // de création remplis) : la création d'un brassin passe avec une marge d'environ
    // 70 expressions, la création d'une recette avec environ 470. Contrôler en plus les
    // valeurs de la copie de l'équipement dépasse la limite : seules ses clés sont
    // contrôlées (risque accepté, exigences-techniques.md, « Règles d'accès »). Sur un
    // brassin rempli après le brassage avec 11 ajustements, isBrewUpdate laisse plus de
    // 900 expressions à un changement de statut, environ 470 à l'écriture des
    // 11 ajustements ; changer tous les groupes d'un coup dépasse la limite, et
    // l'application ne le fait pas.
    //
    // Mesure de la v0.1.17 (même émulateur, pad() = « return true », 98 tiennent dans
    // une règle « if true » seule, environ 10 expressions chacun), recipe.author de
    // 120 caractères : création d'un brassin qui copie la plus grande recette 4 pad(),
    // soit une marge d'environ 40 expressions (8 sans auteur) ; création d'une recette
    // 64 pad(), modification 61 ; brassin du 22 novembre, statut ou embouteillage,
    // 93 pad() (limite de compilation). Sous users/ : prix au litre 93 pad(), coût figé
    // de 200 lignes dont des lignes en litres 94 pad(). recipe.efficiency, même contrôlé
    // par ses seules clés, faisait refuser la création d'un brassin : il n'est pas
    // stocké. Marge corrigée en v0.1.29 ci-dessous : environ 16 expressions.
    //
    // Mesure de la v0.1.29 (ADR-009, même émulateur). Étalonnage : 98 pad() isolés
    // atteignent la limite de compilation avant le budget ; regroupés par dix
    // (pad10() = dix pad()), 243 tiennent dans une règle « if true » seule. Un pad()
    // vaut donc environ 4 expressions, pas 10 : la marge de la création d'un brassin
    // (4 pad(), inchangée) est d'environ 16 expressions. Marges mesurées avec pad10(),
    // plus grande recette copiée, plus grand déroulé (5 journées de 120 étapes,
    // noms de 120 caractères) : écriture de `process` sur un brassin prévu 145 pad()
    // (environ 590 expressions) ; brassin du 22 novembre avec 11 ajustements,
    // changement de statut 174 pad() (177 avant le contrôle de `process`),
    // embouteillage 138 pad() ; écriture des 11 ajustements 68 pad() (70 avant).
    // Création du plus grand modèle de processus (5 journées de 60 éléments) :
    // 185 pad(). Un lot de 60 step_skipped, plus le début d'étape suivant, passe
    // (rules-tests/test/processes.test.mjs).
    match /brews/{brewId} {
      allow read: if isMember();
      allow create: if isMember()
        && createdByMe(request.resource.data)
        && ownerNameOk(request.resource.data)
        && isBrewCreateShape(request.resource.data);
      allow update: if resource != null
        && isMember()
        && updatedByOwner()
        && isBrewUpdate(request.resource.data)
        && ownerNameOk(request.resource.data);
      allow delete: if isMember() && resource.data.owner_uid == request.auth.uid;

      // Mesures et étapes du jour de brassage, relevés de fermentation : un document
      // par événement, identifiant créé par l'appareil, heure de l'appareil dans measured_at,
      // created_at = serverTimestamp() pour l'audit. Aucune transaction requise.
      function eventFields() {
        return ['owner_uid', 'kind', 'step_key', 'measure_type', 'value', 'note',
                'measured_at', 'created_at', 'phase'];
      }

      // Forme selon kind. Début, fin ou saut d'étape : step_key obligatoire, sans
      // mesure. Mesure : type connu et valeur numérique finie et bornée, step_key nul
      // permis (mesure sans étape). Note : texte de 1 à 2 000 caractères, sans mesure.
      function isEventShape(d) {
        return d.keys().hasOnly(eventFields())
          && d.keys().hasAll(['owner_uid', 'kind', 'measured_at', 'created_at'])
          && d.owner_uid is string
          && stepKeyOk(d)
          && optString(d, 'note', 2000)
          && d.measured_at is timestamp
          && phaseOk(d)
          && (isStepEvent(d) || isMeasurement(d) || isNote(d));
      }

      // Absente ou nulle : jour de brassage. 'fermentation' : relevé après le brassage,
      // sur une mesure ou une note seulement. Immuable : la règle d'update ne la permet
      // pas.
      function phaseOk(d) {
        return !('phase' in d) || d.phase == null
          || (d.phase == 'fermentation' && d.kind in ['measurement', 'note']);
      }

      // Absente, nulle (mesure ou note sans étape), ou de 1 à 100 caractères.
      function stepKeyOk(d) {
        return !('step_key' in d) || d.step_key == null
          || (d.step_key is string && d.step_key.size() >= 1 && d.step_key.size() <= 100);
      }

      function hasNoMeasure(d) {
        return d.get('measure_type', null) == null && d.get('value', null) == null;
      }

      function isStepEvent(d) {
        return d.kind in ['step_started', 'step_ended', 'step_skipped']
          && d.get('step_key', null) is string
          && hasNoMeasure(d);
      }

      // Bornes identiques à celles de la saisie : aucune valeur acceptée à l'écran n'est
      // refusée au retour du réseau. Une comparaison avec NaN est fausse : NaN est
      // refusé, comme Infinity.
      function measureInRange(type, v) {
        return (type == 'temperature' && v >= 0 && v <= 110)
          || (type == 'gravity' && v >= 0.98 && v <= 1.2)
          || (type == 'volume' && v > 0 && v <= 1000)
          || (type == 'ph' && v >= 0 && v <= 14);
      }

      function isMeasurement(d) {
        return d.kind == 'measurement'
          && d.get('value', null) is number
          && measureInRange(d.get('measure_type', null), d.value);
      }

      function isNote(d) {
        return d.kind == 'note'
          && d.get('note', null) is string
          && d.note.size() >= 1
          && hasNoMeasure(d);
      }

      match /events/{eventId} {
        allow read: if isMember();
        allow create: if isMember()
          && isEventShape(request.resource.data)
          && request.resource.data.owner_uid == request.auth.uid
          && request.resource.data.created_at == request.time
          && get(/databases/$(database)/documents/brews/$(brewId)).data.owner_uid
               == request.auth.uid;
        // Correction d'une saisie : valeur, note et heure seulement.
        allow update: if isMember()
          && resource.data.owner_uid == request.auth.uid
          && isEventShape(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['value', 'note', 'measured_at']);
        // Sans lecture du brassin : un événement reste supprimable par son auteur
        // si le brassin a déjà été supprimé.
        allow delete: if isMember() && resource.data.owner_uid == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------- users

    // Prix d'achat, frais, stock et coût réel d'un brassin : privés à leur
    // propriétaire (P5). Aucune lecture par l'admin, aucune lecture par le groupe.
    // Le joker n'accorde que la lecture : les règles s'additionnent, et une écriture
    // permise ici rendrait sans effet les contrôles de forme ci-dessous. Chaque
    // collection écrite a sa propre match ; tout autre chemin reste en lecture seule.
    match /users/{uid}/{document=**} {
      allow read: if isMember() && isSelf(uid);
    }

    // Prix d'un achat (v0.5). Identifiant : clé d'ingrédient (`ingredientKey`),
    // préfixe de nature puis nom normalisé, 100 caractères au plus. Un prix négatif ou
    // non fini rendrait le calcul du coût impossible ; un prix nul est un prix connu.
    // Unité : grammes, sachets, ou litres depuis la v0.1.17 (prix au litre d'un ajout
    // ou d'un houblon mesuré en volume). L'application ne propose les litres qu'au
    // houblon et à l'ajout ; les règles ne lient pas l'unité au préfixe.
    function isPriceShape(d) {
      return d.keys().hasOnly(['name', 'price_eur', 'quantity', 'unit', 'updated_at'])
        && d.keys().hasAll(['name', 'price_eur', 'quantity', 'unit', 'updated_at'])
        && hasName(d, 120)
        && d.price_eur is number && d.price_eur >= 0 && d.price_eur <= 100000
        && d.quantity is number && d.quantity > 0 && d.quantity <= 1000000000
        && d.unit in ['g', 'unit', 'l']
        && d.updated_at == request.time;
    }

    match /users/{uid}/prices/{priceId} {
      allow create, update: if isMember() && isSelf(uid)
        && priceId.size() <= 100
        && priceId.matches('^(malt|sucre|houblon|levure|ajout)(-[a-z0-9]+)*$')
        && isPriceShape(request.resource.data);
      allow delete: if isMember() && isSelf(uid);
    }

    // Frais hors ingrédients (eau, électricité, embouteillage), par brassin ou par
    // bouteille. Identifiant créé par l'appareil. Les 20 postes au plus sont une
    // limite du formulaire : les règles ne comptent pas les documents.
    function isFeeShape(d) {
      return d.keys().hasOnly(['name', 'amount_eur', 'basis', 'updated_at'])
        && d.keys().hasAll(['name', 'amount_eur', 'basis', 'updated_at'])
        && hasName(d, 60)
        && d.amount_eur is number && d.amount_eur >= 0 && d.amount_eur <= 10000
        && d.basis in ['per_brew', 'per_bottle']
        && d.updated_at == request.time;
    }

    match /users/{uid}/fees/{feeId} {
      allow create, update: if isMember() && isSelf(uid)
        && feeId.size() <= 128
        && isFeeShape(request.resource.data);
      allow delete: if isMember() && isSelf(uid);
    }

    // Coût réel figé d'un brassin. Les éléments de `lines` ne peuvent pas être
    // inspectés par les règles : leur nombre est borné, et l'application les écrit à
    // partir des résultats de brewing/ (unité `g`, `unit`, `l` depuis la v0.1.17,
    // `brew`, `bottle`). computed_at est l'heure de l'appareil (le
    // geste du brasseur, hors ligne compris) : aucune comparaison à request.time. Les
    // valeurs d'embouteillage gardées pour l'écart (CB15) ont les bornes de brews/.
    function isBrewCostShape(d, brewId) {
      return d.keys().hasOnly(['brew_id', 'total_eur', 'lines', 'computed_at',
                               'freeze_kind', 'bottles_count', 'packaged_volume_l',
                               'priming_sugar_g', 'priming_sugar_name'])
        && d.keys().hasAll(['brew_id', 'total_eur', 'lines', 'computed_at', 'freeze_kind'])
        && d.brew_id == brewId
        && d.total_eur is number && d.total_eur >= 0 && d.total_eur < 1000000000
        && d.lines is list && d.lines.size() <= 200
        && d.computed_at is timestamp
        && optBottlesCount(d)
        && optPackagedVolume(d)
        && optPrimingSugar(d)
        && optString(d, 'priming_sugar_name', 80);
    }

    // Premier figeage en création seule, « Recalculer » en modification seule : un
    // second appareil qui fige le même brassin est refusé sans écraser le premier
    // (HL5), et aucun coût figé n'est remplacé sans le geste « Recalculer » (CB16).
    match /users/{uid}/brew_costs/{brewId} {
      allow create: if isMember() && isSelf(uid)
        && isBrewCostShape(request.resource.data, brewId)
        && request.resource.data.freeze_kind == 'initial';
      allow update: if isMember() && isSelf(uid)
        && isBrewCostShape(request.resource.data, brewId)
        && request.resource.data.freeze_kind == 'recalculation';
      allow delete: if isMember() && isSelf(uid);
    }

    // Choix par défaut du formulaire « Nouveau brassin » (ADR-009) : état propre au
    // lecteur, jamais écrit sur le modèle lu par le groupe. Un seul document.
    match /users/{uid}/preferences/processes {
      allow create, update: if isMember() && isSelf(uid)
        && request.resource.data.keys().hasOnly(['default_template_id', 'updated_at'])
        && optString(request.resource.data, 'default_template_id', 128)
        && request.resource.data.updated_at == request.time;
      allow delete: if isMember() && isSelf(uid);
    }

    // Stock : arrive après la v1, sans contrôle de forme jusque-là.
    match /users/{uid}/stock/{stockId} {
      allow write: if isMember() && isSelf(uid);
    }

    // ---------------------------------------------------------------- error_reports

    // Journal d'erreurs (P13) : création seule par un membre, sous son uid, champs
    // en liste blanche et bornés. Lecture et suppression par l'admin seul. Le
    // contexte est une chaîne bornée : ni prix, ni stock, ni coût, ni e-mail.
    match /error_reports/{reportId} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['uid', 'feature', 'error', 'stack_trace', 'context', 'app_version',
              'platform', 'created_at'])
        && request.resource.data.keys().hasAll(
             ['uid', 'feature', 'error', 'created_at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.feature is string
        && request.resource.data.feature.size() >= 1
        && request.resource.data.feature.size() <= 100
        && request.resource.data.error is string
        && request.resource.data.error.size() <= 2000
        && optString(request.resource.data, 'stack_trace', 8000)
        && optString(request.resource.data, 'context', 2000)
        && optString(request.resource.data, 'app_version', 40)
        && (!('platform' in request.resource.data)
            || request.resource.data.platform in ['android', 'web'])
        && request.resource.data.created_at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------------------------------------------------------------- référentiels

    // Référentiels et recettes publiques (ADR-005, P19) : écrits par l'ingestion seule
    // (ingest/, Admin SDK, hors règles), jamais par un client ; lus par tout membre. Une
    // entrée et beer_index/{nature} se lisent par get seul : aucune requête sur ces
    // collections. public_recipes se lit par pages de 50 au plus (P22) : une requête
    // sans limite, ou de plus de 50, est refusée.
    match /beer_fermentables/{entryId} {
      allow get: if isMember();
      allow write: if false;
    }

    match /beer_hops/{entryId} {
      allow get: if isMember();
      allow write: if false;
    }

    match /beer_cultures/{entryId} {
      allow get: if isMember();
      allow write: if false;
    }

    match /beer_miscs/{entryId} {
      allow get: if isMember();
      allow write: if false;
    }

    match /beer_styles/{styleId} {
      allow get: if isMember();
      allow write: if false;
    }

    match /beer_index/{nature} {
      allow get: if isMember();
      allow write: if false;
    }

    match /public_recipes/{recipeId} {
      allow get: if isMember();
      allow list: if isMember() && request.query.limit <= 50;
      allow write: if false;
    }

    // Comptes rendus de l'ingestion : écrits par le script seul, lus par l'admin
    // (Admin › Sources, L4).
    match /ingest_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Noms non résolus (ADR-005, D6 et E6) : écrits par le script (source diydog,
    // identifiant SHA-256 de « nature|nom normalisé », sans key) et, après un import,
    // par un membre (source import, key = nom normalisé, identifiant SHA-256 de
    // « import|nature|key », vérifié à la création : les deux origines ne partagent
    // jamais un document). Un membre crée le document à count 1, puis le compte monte
    // d'un à chaque import ; name peut changer de graphie, nature, key et source ne
    // changent pas, et seul un document d'import se met à jour. Ni e-mail, ni uid, ni
    // nom de fichier. Lu par l'admin seul, jamais supprimé par un client.
    function isUnresolvedId(id) {
      return id.matches('^[0-9a-f]{64}$');
    }

    function unresolvedFields() {
      return request.resource.data.keys().hasOnly(
               ['nature', 'key', 'name', 'source', 'count', 'updated_at'])
        && request.resource.data.keys().hasAll(
               ['nature', 'key', 'name', 'source', 'count', 'updated_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.count is int
        && request.resource.data.updated_at == request.time;
    }

    match /import_unresolved/{unresolvedId} {
      allow read: if isAdmin();
      allow create: if isMember()
        && isUnresolvedId(unresolvedId)
        && unresolvedFields()
        && request.resource.data.nature in ['fermentable', 'hop', 'culture', 'misc']
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 1
        && request.resource.data.key.size() <= 100
        && request.resource.data.key.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && hashing.sha256('import|' + request.resource.data.nature + '|'
             + request.resource.data.key).toHexString().lower() == unresolvedId
        && request.resource.data.source == 'import'
        && request.resource.data.count == 1;
      allow update: if isMember()
        && isUnresolvedId(unresolvedId)
        && resource.data.source == 'import'
        && unresolvedFields()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'count', 'updated_at'])
        && resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ---------------------------------------------------------------- tickets

    // Tickets des membres (ADR-006, P23). Le membre crée son ticket hors ligne compris ;
    // un déclencheur le publie en Issue sur le dépôt public et seul le serveur (SDK
    // Admin, hors règles) écrit ensuite le statut et les champs GitHub. Le client n'écrit
    // que les champs de la création, puis `seen_by_author_at`.
    //
    // `screen` : modèle de route go_router (segments littéraux en minuscules et
    // paramètres `:id`), `autre` ou `inconnu`. Un identifiant réel de document ne passe
    // pas : l'écran part sur le dépôt public.
    function isTicketCreation(d) {
      return d.keys().hasOnly(['type', 'title', 'description', 'screen', 'app_version',
                               'platform', 'author_uid', 'author_email', 'created_at',
                               'status'])
        && d.keys().hasAll(['type', 'title', 'description', 'screen', 'platform',
                            'author_uid', 'author_email', 'created_at', 'status'])
        && d.type in ['bug', 'evolution', 'feature']
        && d.title is string && d.title.size() >= 5 && d.title.size() <= 100
        && d.title.matches('[^\\r\\n]*')
        && d.description is string
        && d.description.size() >= 10 && d.description.size() <= 2000
        && d.screen is string && d.screen.size() <= 100
        && (d.screen in ['autre', 'inconnu', '/']
            || d.screen.matches('(/([a-z][a-z-]{0,39}|:[A-Za-z][A-Za-z0-9]{0,39}))+'))
        && (!('app_version' in d)
            || (d.app_version is string && d.app_version.size() >= 1
                && d.app_version.size() <= 40))
        && d.platform in ['android', 'web']
        && d.author_uid == request.auth.uid
        && d.author_email == emailKey()
        && d.created_at == request.time
        && d.status == 'pending';
    }

    match /tickets/{ticketId} {
      allow create: if isMember()
        && ticketId.matches('[A-Za-z0-9_-]{1,128}')
        && isTicketCreation(request.resource.data);

      // Lecture par l'auteur (requête « Mes tickets » filtrée sur author_uid) et l'admin.
      allow read: if isMember()
        && (resource.data.author_uid == request.auth.uid || isAdmin());

      // Deux mises à jour client, à l'heure du serveur : l'auteur marque le suivi lu ;
      // l'admin demande un nouvel envoi d'un ticket `send_failed` (T2), que la tâche
      // horaire reprend.
      allow update: if (isMember()
          && resource.data.author_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['seen_by_author_at'])
          && request.resource.data.seen_by_author_at == request.time)
        || (isAdmin()
          && resource.data.status == 'send_failed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['retry_requested_at'])
          && request.resource.data.retry_requested_at == request.time);

      allow delete: if false;

      // Décisions de l'admin (ADR-006, T2, P23) : un document par décision, appliqué sur
      // l'Issue par un déclencheur. Le serveur (SDK Admin, hors règles) écrit ensuite
      // `state`, `error_reason`, `steps_done`, `applied_at`, `comment_id`, `lease_until`,
      // `updated_at`. Le membre ne lit pas les décisions : il lit `reply_text` et le
      // statut sur son ticket.
      match /decisions/{decisionId} {
        allow create: if isAdmin()
          && decisionId.matches('[A-Za-z0-9_-]{1,128}')
          && exists(/databases/$(database)/documents/tickets/$(ticketId))
          && isDecisionCreation(request.resource.data);

        allow read: if isAdmin();

        // Seule mise à jour client : « Réessayer » sur une décision en échec.
        allow update: if isAdmin()
          && resource.data.state == 'failed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['retry_requested_at'])
          && request.resource.data.retry_requested_at == request.time;

        allow delete: if false;
      }
    }

    // Décision telle que l'admin la crée : `text` (motif ou commentaire, 5 à 2 000
    // caractères) présent pour `refuse` et `close`, absent pour `validate`.
    function isDecisionCreation(d) {
      return d.keys().hasOnly(['action', 'text', 'state', 'requested_by_uid',
                               'requested_at'])
        && d.keys().hasAll(['action', 'state', 'requested_by_uid', 'requested_at'])
        && d.action in ['validate', 'refuse', 'close']
        && d.state == 'pending'
        && d.requested_by_uid == request.auth.uid
        && d.requested_at == request.time
        && (d.action == 'validate'
          ? !('text' in d)
          : ('text' in d && d.text is string
             && d.text.size() >= 5 && d.text.size() <= 2000));
    }

    // Compteurs du plafond du jour : serveur seul (SDK Admin).
    match /ticket_quotas/{document=**} {
      allow read, write: if false;
    }

    // État du jeton GitHub : écrit par le serveur, lu par l'admin (bandeau de la page Admin).
    match /ticket_status/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
