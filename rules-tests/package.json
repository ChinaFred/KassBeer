{
  "name": "kassbeer-rules-tests",
  "private": true,
  "description": "Tests de firestore.rules et storage.rules rejoués contre les émulateurs Firebase (projet demo-kassbeer, sans contact avec la production).",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "firebase --config ../firebase.json emulators:exec --only firestore,storage --project demo-kassbeer \"node --test --test-concurrency=1 test/*.test.mjs\"",
    "format": "prettier --write \"test/**/*.mjs\"",
    "format:check": "prettier --check \"test/**/*.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "ajv": "8.20.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.35.0",
    "prettier": "3.9.6"
  }
}
