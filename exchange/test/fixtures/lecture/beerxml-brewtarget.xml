<?xml version="1.0" encoding="UTF-8"?>
<!-- Fichier écrit à la main, à la manière d'un export Brewtarget : deux fois la même recette, puis une recette sans nom. -->
<RECIPES>
  <RECIPE>
    <NAME>Rousse de décoction</NAME>
    <VERSION>1</VERSION>
    <TYPE>All Grain</TYPE>
    <BREWER>Brasseur Fictif</BREWER>
    <ASST_BREWER>Aide Fictive</ASST_BREWER>
    <BATCH_SIZE>18.5</BATCH_SIZE>
    <BOIL_SIZE>24</BOIL_SIZE>
    <BOIL_TIME>90</BOIL_TIME>
    <EFFICIENCY>68</EFFICIENCY>
    <HOPS>
      <HOP>
        <NAME>Tettnang</NAME>
        <VERSION>1</VERSION>
        <ALPHA>4.5</ALPHA>
        <AMOUNT>0.04</AMOUNT>
        <USE>Boil</USE>
        <TIME>60</TIME>
        <TYPE>Aroma</TYPE>
        <FORM>Plug</FORM>
        <BETA>4</BETA>
      </HOP>
      <HOP>
        <NAME>Hallertau</NAME>
        <VERSION>1</VERSION>
        <ALPHA>4</ALPHA>
        <AMOUNT>0.02</AMOUNT>
        <USE>Boil</USE>
        <TIME>10</TIME>
        <FORM>Leaf</FORM>
      </HOP>
    </HOPS>
    <FERMENTABLES>
      <FERMENTABLE>
        <NAME>Munich</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>4</AMOUNT>
        <YIELD>80</YIELD>
        <COLOR>9</COLOR>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Malt torréfié</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>0.05</AMOUNT>
        <YIELD>65</YIELD>
        <COLOR>450</COLOR>
      </FERMENTABLE>
    </FERMENTABLES>
    <MISCS>
      <MISC>
        <NAME>Chlorure de calcium</NAME>
        <VERSION>1</VERSION>
        <TYPE>Water Agent</TYPE>
        <USE>Mash</USE>
        <TIME>60</TIME>
        <AMOUNT>0.003</AMOUNT>
        <AMOUNT_IS_WEIGHT>TRUE</AMOUNT_IS_WEIGHT>
      </MISC>
    </MISCS>
    <YEASTS>
      <YEAST>
        <NAME>Lager liquide</NAME>
        <VERSION>1</VERSION>
        <TYPE>Lager</TYPE>
        <FORM>Liquid</FORM>
        <AMOUNT>0.2</AMOUNT>
        <AMOUNT_IS_WEIGHT>FALSE</AMOUNT_IS_WEIGHT>
        <ATTENUATION>74</ATTENUATION>
      </YEAST>
    </YEASTS>
    <WATERS/>
    <STYLE>
      <NAME>Märzen</NAME>
      <VERSION>1</VERSION>
      <CATEGORY>Amber Malty European Lager</CATEGORY>
      <CATEGORY_NUMBER>6</CATEGORY_NUMBER>
      <STYLE_LETTER>A</STYLE_LETTER>
      <STYLE_GUIDE>BJCP 2021</STYLE_GUIDE>
      <TYPE>Lager</TYPE>
      <OG_MIN>1.054</OG_MIN>
      <OG_MAX>1.060</OG_MAX>
      <FG_MIN>1.010</FG_MIN>
      <FG_MAX>1.014</FG_MAX>
      <IBU_MIN>18</IBU_MIN>
      <IBU_MAX>24</IBU_MAX>
      <COLOR_MIN>8</COLOR_MIN>
      <COLOR_MAX>17</COLOR_MAX>
    </STYLE>
    <MASH>
      <NAME>Empâtage</NAME>
      <VERSION>1</VERSION>
      <GRAIN_TEMP>15</GRAIN_TEMP>
      <MASH_STEPS>
        <MASH_STEP>
          <NAME>Empâtage à 55</NAME>
          <VERSION>1</VERSION>
          <TYPE>Temperature</TYPE>
          <STEP_TEMP>55</STEP_TEMP>
          <STEP_TIME>20</STEP_TIME>
        </MASH_STEP>
        <MASH_STEP>
          <NAME>Décoction</NAME>
          <VERSION>1</VERSION>
          <TYPE>Decoction</TYPE>
          <STEP_TEMP>66</STEP_TEMP>
          <STEP_TIME>45</STEP_TIME>
          <DECOCTION_AMT>6</DECOCTION_AMT>
        </MASH_STEP>
      </MASH_STEPS>
    </MASH>
    <NOTES><![CDATA[Décoction simple, <recette> fictive.]]></NOTES>
  </RECIPE>
